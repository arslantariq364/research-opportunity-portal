  "item": [
    {
      "name": "01. Create Opportunity 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response returns valid JSON with auto-generated ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"object\");",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData.id).to.be.a(\"number\");",
              "    pm.expect(jsonData.id).to.be.above(0);",
              "    ",
              "    // Capture generated ID into collection variable for downstream sequential requests",
              "    pm.collectionVariables.set(\"opportunity_id\", jsonData.id);",
              "    console.log(\"Captured opportunity_id: \" + jsonData.id);",
              "});",
              "",
              "pm.test(\"Created Opportunity 1 contains accurate attributes\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql(\"Quantum Error Correction with Topological Codes\");",
              "    pm.expect(jsonData.research_area).to.eql(\"Quantum Computing\");",
              "    pm.expect(jsonData.faculty_name).to.eql(\"Dr. Ayesha Malik\");",
              "    pm.expect(jsonData.department).to.eql(\"Computer Science\");",
              "    pm.expect(jsonData.required_skills).to.eql(\"Python, Qiskit, Linear Algebra, Quantum Mechanics\");",
              "    pm.expect(jsonData.available_positions).to.eql(2);",
              "    pm.expect(jsonData.application_deadline).to.eql(\"2026-11-30\");",
              "    pm.expect(jsonData.status).to.eql(\"Open\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Quantum Error Correction with Topological Codes\",\n  \"description\": \"Investigating fault-tolerant quantum memory, stabilizer circuits, and lattice surgery techniques on superconducting qubit processors.\",\n  \"research_area\": \"Quantum Computing\",\n  \"faculty_name\": \"Dr. Ayesha Malik\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Qiskit, Linear Algebra, Quantum Mechanics\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-11-30\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Creates a first test research opportunity in Computer Science. Automatically extracts and stores the generated record ID in the collection variable 'opportunity_id'."
      },
      "response": []
    },
