    {
      "name": "04. Retrieve All Opportunities",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a non-empty array of opportunity objects\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.at.least(3);",
              "});",
              "",
              "pm.test(\"Stored opportunities array includes captured opportunity_id\", function () {",
              "    var jsonData = pm.response.json();",
              "    var targetId = pm.collectionVariables.get(\"opportunity_id\");",
              "    pm.expect(targetId, \"Target opportunity_id variable must be set\").to.not.be.empty;",
              "    ",
              "    var found = jsonData.find(function(item) {",
              "        return item.id == targetId;",
              "    });",
              "    pm.expect(found, \"Captured opportunity must be present in GET all list\").to.not.be.undefined;",
              "    pm.expect(found.title).to.eql(\"Quantum Error Correction with Topological Codes\");",
              "});"
            ]
          }
        }
